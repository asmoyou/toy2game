{
  "name": "toy2game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs && npm test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:games": "node scripts/test-games.mjs",
    "covers": "node scripts/capture-covers.mjs",
    "deploy:workers": "wrangler deploy",
    "preview:cloudflare": "wrangler dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "pngjs": "^7.0.0",
    "vite": "^7.3.1",
    "wrangler": "^4.129.0"
  }
}
